# ============================================================
#  Duomo Flagship Dashboard — Secrets 템플릿
#  Streamlit Cloud > App Settings > Secrets 에 동일 내용 등록
#  (로컬: dashboard/.streamlit/secrets.toml 로 복사 후 토큰 입력)
# ============================================================

# === Notion API ===
# Step 1: https://www.notion.so/my-integrations → New integration → Internal Integration Secret 복사
# Step 2: 각 DB 우상단 ⋯ → Connections → 본 integration 추가 (3개 DB 모두)
NOTION_TOKEN = "ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# === 발견된 Duomo Notion DB (자동 입력됨, 그대로 사용 가능) ===
ORDERS_DB_ID = "b4a420d2-9bdc-4971-b1c9-a19306ad8cbe"        # 발주 권고 마스터
TASKS_DB_ID = "d0f673d9-dc62-4f20-9a6b-1090d96a5313"          # 주작업
MEETING_DB_ID = "0699ce3b-e55f-4995-8242-a5098c50fcc6"        # 회의록

# === 캘린더 DB (사용자 신규 생성 후 ID 입력 권장) ===
# notion_setup_guide.md 참조하여 "Duomo 팀 캘린더" DB 생성 후 ID 등록.
# 미입력 시 주작업 DB 날짜 컬럼으로 자동 fallback.
CALENDAR_DB_ID = ""

# === Google Sheets (업무일지 시트 인증) ===
[gcp_service_account]
type = "service_account"
project_id = "duomo-dashboard"
private_key_id = "xxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
client_email = "duomo-dashboard-sa@duomo-dashboard.iam.gserviceaccount.com"
client_id = "111111111111111111111"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."

[sheets]
worklog_id = "1enUaMwY092nn27BDTxvHCz9hmrZRVIxXTSU3JKjmw64"
