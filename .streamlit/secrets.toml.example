# ============================================================
#  Duomo Flagship Dashboard — Secrets 템플릿 (v0.5)
#  Streamlit Cloud > App Settings > Secrets 에 동일 내용 등록
#  (로컬: .streamlit/secrets.toml 로 복사 후 토큰 입력)
# ============================================================

# === Notion API ===
# https://www.notion.so/my-integrations → New integration → Internal Integration Secret 복사
# 생성 후 아래 3개 DB (캘린더/주작업/회의록) 각각 ⋯ → Connections → 본 integration 연결
NOTION_TOKEN = "ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# === 캘린더 DB (사용자 제공) ===
# https://www.notion.so/2bf27f0fc3178054a65dead0fef4cbe0
CALENDAR_DB_ID = "2bf27f0f-c317-8054-a65d-ead0fef4cbe0"

# === 주작업 (태스크) DB ===
TASKS_DB_ID = "d0f673d9-dc62-4f20-9a6b-1090d96a5313"

# === 회의록 DB (플래그십 전용 신규 생성) ===
# notion_setup_guide.md "회의록" 섹션 참조 — 컬럼 스키마 준수 후 ID 입력.
# 미입력 시 회의록 위젯은 비활성화.
MEETING_DB_ID = ""

# === 입고알람 이력 DB (플래그십 전용 신규 생성) ===
# notion_setup_guide.md 5-B 섹션 참조. "확인 처리" 액션 기록용.
# 미입력 시 입고 추적 모듈은 동작하나 알람 숨김 기능만 비활성.
INBOUND_HISTORY_DB_ID = ""

# === 발주 (Notion 연동 제외) ===
# 발주시스템 v3 (외부) 별도 운영. 본 대시보드 발주 모듈은 더미 / 향후 v3 연동.
# ORDERS_DB_ID = ""

# === Google Sheets (업무일지 시트 인증) ===
[gcp_service_account]
type = "service_account"
project_id = "duomo-dashboard"
private_key_id = "xxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
client_email = "duomo-dashboard-sa@duomo-dashboard.iam.gserviceaccount.com"
client_id = "111111111111111111111"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."

[sheets]
worklog_id = "1enUaMwY092nn27BDTxvHCz9hmrZRVIxXTSU3JKjmw64"
